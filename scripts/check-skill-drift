#!/bin/sh
set -eu
src=skills/tiny-platform/SKILL.md
for dst in skills/tiny-app-development/SKILL.md skills/tiny-deploy/SKILL.md skills/tiny-operator/SKILL.md; do
  a=$(sed -n '/<!-- shared:security:start -->/,/<!-- shared:security:end -->/p' "$src")
  b=$(sed -n '/<!-- shared:security:start -->/,/<!-- shared:security:end -->/p' "$dst")
  test "$a" = "$b" || { echo "shared skill block drift: $dst" >&2; exit 1; }
done
