{
  "name": "@tinyhost/sdk",
  "version": "0.1.0",
  "description": "Typed browser SDK for TinyHost app identity, KV, and realtime capabilities",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisMarxDev/tiny.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/ChrisMarxDev/tiny/issues"
  },
  "homepage": "https://github.com/ChrisMarxDev/tiny#readme",
  "keywords": [
    "tinyhost",
    "browser",
    "sdk",
    "self-hosted"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:live": "node test/live.test.mjs",
    "test:blobs": "node test/blobs.test.mjs",
    "test:examples": "node test/examples-compile.mjs && node ../../examples/sdk-apps/build.mjs --check",
    "test:bundle": "node test/bundle-size.mjs",
    "test:package": "node test/package-contents.mjs",
    "test:version": "node test/version-sync.mjs",
    "test:distribution": "node test/distribution.mjs",
    "test": "npm run build && npm run test:live && npm run test:blobs && npm run test:examples && npm run test:bundle && npm run test:package && npm run test:version && npm run test:distribution",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "4.1.3"
  }
}
