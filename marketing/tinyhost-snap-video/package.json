{
  "name": "tinyhost-snap-video",
  "version": "1.0.0",
  "description": "Dynamic 13-second product film for TinyHost",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.502",
    "@remotion/media": "4.0.502",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.502"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.502",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render TinyHostSnap out/tinyhost-dynamic.mp4",
    "render:no-bgm": "remotion render TinyHostSnap out/tinyhost-dynamic-no-bgm.mp4 --props=props-no-bgm.json",
    "stills": "remotion still TinyHostSnap out/create.png --frame=68 && remotion still TinyHostSnap out/deploy.png --frame=160 && remotion still TinyHostSnap out/upload.png --frame=213 && remotion still TinyHostSnap out/protected.png --frame=304 && remotion still TinyHostSnap out/end-card.png --frame=365",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
