{
  "name": "tinkercloud-snap-video",
  "version": "1.0.0",
  "description": "Dynamic 25-second product film for Tinkercloud",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.502",
    "@remotion/media": "4.0.502",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.502"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.502",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render TinkercloudSnap out/tinkercloud-dynamic.mp4",
    "render:no-bgm": "remotion render TinkercloudSnap out/tinkercloud-dynamic-no-bgm.mp4 --props=props-no-bgm.json",
    "stills": "remotion still TinkercloudSnap out/create.png --frame=110 && remotion still TinkercloudSnap out/deploy.png --frame=250 && remotion still TinkercloudSnap out/upload.png --frame=420 && remotion still TinkercloudSnap out/protected.png --frame=580 && remotion still TinkercloudSnap out/end-card.png --frame=710",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
